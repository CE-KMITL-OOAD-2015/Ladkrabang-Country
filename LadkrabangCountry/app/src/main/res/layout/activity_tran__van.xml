<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
    android:layout_height="match_parent" android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context="com.awakenguys.kmitl.ladkrabangcountry.Tran_Van">


    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/imageView5"
        android:src="@drawable/table_in"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true" />

        <Button android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/map1"
            android:id="@+id/sci"
            android:background="@color/pink"
            android:layout_marginEnd="45dp"
            android:layout_alignBottom="@+id/imageView5"
            android:layout_alignEnd="@+id/imageView5"
            android:layout_marginBottom="43dp"
            android:onClick="van_soi">
        </Button>
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/map2"
            android:id="@+id/soi"
            android:background="@color/pink"
            android:layout_alignParentTop="true"
            android:layout_alignStart="@+id/sci"
            android:layout_marginTop="48dp"
            android:onClick="van_sci">

        </Button>

</RelativeLayout>
